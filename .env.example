APP_NAME="Layanan Surat Kalurahan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=layanan_warga
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = tulis email ke storage/logs, tidak masuk kotak surat. smtp = kirim sungguhan setelah host, port, dan sandi diisi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kata sandi akun percobaan lokal. Ganti sebelum server dipakai warga.
SEED_PASSWORD=kalurahan-dev
KALURAHAN_NAMA=Sindumartani
KALURAHAN_KAPANEWON=Ngemplak
KALURAHAN_KABUPATEN=Sleman
KALURAHAN_ALAMAT="Sorobayan, Sindumartani, Ngemplak, Sleman, DIY 55584"
KALURAHAN_LAMAN=www.sindumartani.desa.id
KALURAHAN_SUREL=desasindumartani@slemankab.go.id
KALURAHAN_LURAH="Drs. H. Anang Zamroni, M.SI"
SURAT_NOMOR_FORMAT="{kode}/{nomor}/{bulan_romawi}/{tahun}"
SURAT_NOMOR_DIKONFIRMASI=false
# whatsapp = kirim JSON {pengirim, tujuan, pesan} ke pintu WABlast. Tanpa URL, pengiriman berstatus gagal.
NOTIFIKASI_KANAL=whatsapp
KALURAHAN_WHATSAPP=0881080712007
# gambar = scan tanda tangan. bsre = kirim PDF ke gateway, simpan hanya jika jawaban PDF.
TTE_MODE=gambar
BSRE_URL=
BSRE_TOKEN=
BSRE_NIK=
# WABlast berjalan di komputer yang sama. Token harus sama dengan WHATSAPP_GATEWAY_TOKEN di WABlast.
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001/api/gateway/kirim
WHATSAPP_GATEWAY_TOKEN=
# Di server produksi: APP_URL memakai https dan SESSION_SECURE_COOKIE=true
